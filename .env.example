# Public browser configuration. The anon/publishable key is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only importer configuration. Never expose this value to browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Property invitation delivery. Keep the token out of NEXT_PUBLIC_* values.
PROPERTY_INVITE_DELIVERY_WEBHOOK=
PROPERTY_INVITE_DELIVERY_TOKEN=
